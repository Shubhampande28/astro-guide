# Copy this file to .env and fill in real values. Never commit .env.

ENV=development

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+asyncpg://jyotish:jyotish@postgres:5432/jyotish_guru

# Redis
REDIS_URL=redis://redis:6379/0

# AI rewrite provider for chat answers: claude | openai | gemini | none
# Only chart facts and rule results are ever sent, never names or raw birth details.
AI_PROVIDER=none
CLAUDE_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Auth
JWT_SECRET=change-me-in-production

# Razorpay (test mode keys for Phase 8)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
