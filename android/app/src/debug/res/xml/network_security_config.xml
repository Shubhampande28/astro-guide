<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only override of src/main/res/xml/network_security_config.xml:
     allows plain HTTP, but only to 10.0.2.2, the Android emulator's alias
     for the host machine where the Docker Compose backend runs (A2). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
